    <OCV_Lib>e:/Dev/Libs/OpenCV/lib</OCV_Lib>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="OpenCV-Dirs">
    <OCV_Inc>e:/Dev/Libs/OpenCV/include</OCV_Inc>
    <OCV_Lib>e:/Dev/Libs/OpenCV/lib</OCV_Lib>
  </PropertyGroup>
</Project>
